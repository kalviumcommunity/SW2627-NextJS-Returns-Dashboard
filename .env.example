# Postgres connection string (local/dev instance, or Cloud SQL in production)
DATABASE_URL="postgresql://user:password@localhost:5432/returns_dashboard?schema=public"

# Random string used to sign session JWTs — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Shared secret required by POST /api/returns/auto-approve (the SLA sweep cron target)
CRON_SECRET=""
